{
  "name": "@arkli/dsh-suite",
  "version": "0.1.0",
  "description": "Explicit composition of the model OAuth replacement and selected workspace plugins",
  "type": "module",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": "0.2.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@arkli/dsh-model-oauth": "workspace:*",
    "@arkli/dsh-model-oauth-adapter": "workspace:*",
    "@arkli/dsh-model-oauth-authorization": "workspace:*",
    "@arkli/dsh-model-oauth-ui": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
