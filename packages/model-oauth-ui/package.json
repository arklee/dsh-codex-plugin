{
  "name": "@arkli/dsh-model-oauth-ui",
  "version": "0.1.0",
  "description": "Models settings and provider OAuth onboarding for the model OAuth replacement bundle.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "locale",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": "0.2.3-alpha.2"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@arkli/dsh-model-oauth-authorization": "workspace:*",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-config": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-text-search": "0.2.3-alpha.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-config": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-text-search": "0.2.3-alpha.2",
    "react": "^18.2.0",
    "@types/react": "^18.3.0",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "esbuild": "0.25.12",
    "lightningcss": "1.30.2",
    "typescript": "^5.9.3"
  }
}
