{
  "name": "@arkli/dsh-model-oauth-authorization",
  "version": "0.1.0",
  "description": "Owner-only model OAuth authorization RPC bridge for DSH.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.22.3",
    "dsh": "0.2.3-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-authorization": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.3-alpha.2",
    "@deepseek-ai/cordis": "4.2.0-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-authorization": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.3-alpha.2",
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.3-alpha.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "@types/node": "^24.0.0"
  }
}
