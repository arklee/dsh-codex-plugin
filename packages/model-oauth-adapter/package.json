{
  "name": "@arkli/dsh-model-oauth-adapter",
  "description": "Replacement pi-ai adapter with provider OAuth and pi-ai 1.6.0",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "locale",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.2.0-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-authorization": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.3-alpha.2"
  },
  "dependencies": {
    "@arkli/pi-ai-patched": "workspace:*",
    "@deepseek-ai/cosmokit": "1.10.0-alpha.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.2.3-alpha.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts"
  }
}
